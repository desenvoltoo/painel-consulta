# Aplicação
APP_ENV=development
APP_NAME=Painel de Consulta
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=troque-por-uma-chave-segura

# PostgreSQL
POSTGRES_DB=painel_consulta
POSTGRES_USER=painel_consulta
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql+asyncpg://painel_consulta:troque-esta-senha@postgres:5432/painel_consulta

# Redis
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_GROUP_ID=
TELEGRAM_RESPONSE_BOT_ID=
TELEGRAM_SESSION_PATH=/app/sessions/painel-consulta

# Consulta
QUERY_TIMEOUT_SECONDS=120
MAX_CONCURRENT_QUERIES=1
EXPORT_RETENTION_HOURS=24
AUDIT_RETENTION_DAYS=180
